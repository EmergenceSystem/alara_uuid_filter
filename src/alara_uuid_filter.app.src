{application, alara_uuid_filter, [
    {description, "em_filter agent exposing the alara_uuid UUID generation API"},
    {vsn, "0.2.0"},
    {registered, [alara_uuid_filter_sup, alara_uuid_filter_server]},
    {mod, {alara_uuid_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter,
        alara_uuid
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        alara_uuid_filter_sup,
        alara_uuid_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/alara_uuid_filter"}]}
]}.
